# URL pública do site (usada em SEO, sitemap, robots e Open Graph)
NEXT_PUBLIC_SITE_URL=https://fortnelcher.com.br

# Google Analytics 4 - ID de métricas (formato G-XXXXXXXXXX)
# Deixe em branco para desativar o rastreamento.
NEXT_PUBLIC_GA_ID=

# Envio de e-mail do formulário de contato via Resend (opcional).
# Sem essas variáveis, a rota /api/contact apenas valida os dados
# e registra a mensagem no log do servidor.
RESEND_API_KEY=
CONTACT_TO_EMAIL=fortnelcher@gmail.com
